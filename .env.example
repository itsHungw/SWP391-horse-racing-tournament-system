# Copy to .env and adjust. .env is gitignored — never commit real secrets.
# Used by docker-compose.yml and when running the backend locally.

# --- Spring profile ---
# dev  -> local PostgreSQL + MinIO (this file's defaults)
# prod -> production PostgreSQL + Cloudflare R2 (S3-compatible)
SPRING_PROFILES_ACTIVE=dev

# --- Database (local PostgreSQL from docker-compose) ---
DB_NAME=horseracing
DB_URL=jdbc:postgresql://localhost:5432/horseracing
DB_USERNAME=horseracing
DB_PASSWORD=local123

# --- Auth ---
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# --- Object storage ---
# Local (MinIO): keep the endpoint + static keys below.
# Production R2: set the bucket, account endpoint, access key, secret key, and
# region `auto` in infra/.env.prod.
OBJECT_STORAGE_BUCKET=horseracing-dev
OBJECT_STORAGE_REGION=ap-southeast-1
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# --- Mail (optional locally) ---
APP_MAIL_ENABLED=false

# --- VNPay (ví điện tử / nạp tiền) ---
# Đăng ký merchant sandbox tại https://sandbox.vnpayment.vn để lấy TmnCode + HashSecret.
# Để trống thì tính năng nạp tiền bị tắt (báo SERVICE_UNAVAILABLE).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/wallet/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/wallet
VNPAY_MIN_AMOUNT=10000
VNPAY_MAX_AMOUNT=50000000
