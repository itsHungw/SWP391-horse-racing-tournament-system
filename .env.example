# Copy to .env and adjust. .env is gitignored — never commit real secrets.
# Used by docker-compose.yml and when running the backend locally.

# --- Spring profile ---
# dev  -> local SQL Server + MinIO (this file's defaults)
# prod -> real cloud DB + real AWS S3 (IAM role)
SPRING_PROFILES_ACTIVE=dev

# --- Database (local SQL Server from docker-compose) ---
DB_SA_PASSWORD=Local_Dev_Password123
DB_NAME=horseracing
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=horseracing;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=Local_Dev_Password123

# --- Auth ---
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# --- Object storage ---
# Local (MinIO): keep the endpoint + static keys below.
# Real AWS: set AWS_S3_BUCKET to the cloud bucket, leave AWS_S3_ENDPOINT,
# AWS_S3_ACCESS_KEY, AWS_S3_SECRET_KEY blank, and rely on the instance IAM role.
AWS_S3_BUCKET=horseracing-dev
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_ACCESS_KEY=minioadmin
AWS_S3_SECRET_KEY=minioadmin

# --- Mail (optional locally) ---
APP_MAIL_ENABLED=false
