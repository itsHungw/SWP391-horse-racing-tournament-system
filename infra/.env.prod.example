# Copy to infra/.env.prod ON THE VM and fill in real values.
# infra/.env.prod is gitignored — NEVER commit real secrets.
# Consumed by docker-compose.prod.yml (both for ${...} interpolation and as the
# backend container's env_file).

SPRING_PROFILES_ACTIVE=prod

# --- Backend image (built by GitHub Actions -> GHCR). MUST be lowercase. -----
BACKEND_IMAGE=ghcr.io/itshungw/swp391-horse-racing-tournament-system:latest

# --- Database (self-hosted Postgres container on this VM) --------------------
DB_NAME=horseracing
DB_USERNAME=horseracing
DB_PASSWORD=CHANGE_ME_strong_random_password
# DB_URL is injected by compose as jdbc:postgresql://postgres:5432/${DB_NAME}

# --- Auth --------------------------------------------------------------------
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME_at_least_32_random_characters

# --- CORS / frontend ---------------------------------------------------------
# Use the SAME registrable domain as the API so the refresh-token cookie
# (SameSite) is sent on FE -> API requests. app.* and api.* are same-site.
APP_CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
APP_FRONTEND_BASE_URL=https://app.yourdomain.com

# --- Object storage: Cloudflare R2 (S3-compatible) ---------------------------
OBJECT_STORAGE_BUCKET=your-r2-bucket
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY=your-r2-access-key-id
OBJECT_STORAGE_SECRET_KEY=your-r2-secret-access-key

# --- Behind nginx: trust the proxy so rate-limiting & VNPay (vnp_IpAddr) see
#     the real client IP from X-Forwarded-For, not the docker gateway. --------
APP_RATE_LIMIT_TRUSTED_PROXIES=172.16.0.0/12

# --- Mail (optional) ---------------------------------------------------------
APP_MAIL_ENABLED=false
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@yourdomain.com

# --- VNPay (leave TMN/secret blank to disable top-up) ------------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://api.yourdomain.com/api/v1/wallet/vnpay/return
VNPAY_FRONTEND_RETURN_URL=https://app.yourdomain.com/wallet
